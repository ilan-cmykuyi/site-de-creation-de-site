{
  "name": "booster-site-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "preview": "vite preview",
    "predev": "node scripts/fetch-content.mjs",
    "fetch-content": "node scripts/fetch-content.mjs",
    "check-schema": "node scripts/check-schema.mjs",
    "prebuild": "node scripts/fetch-content.mjs && node scripts/check-schema.mjs",
    "postbuild": "node scripts/prerender.mjs && node scripts/build-sitemap.mjs",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "check": "tsc -b && eslint . --max-warnings 0 && node scripts/check-schema.mjs && vitest run"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.12"
  }
}
