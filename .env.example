# Copier ce fichier en `.env` (jamais commité) et renseigner le jeton du site.
#
# Les deux variables sont lues par le bundle Vite (site.config.ts, préfixe VITE_
# obligatoire pour être exposées au navigateur) ET par scripts/fetch-content.mjs
# (Node, au pré-build). Sur Cloudflare Pages, les poser dans Réglages > Variables.

# URL de l'API publique de Lea CRM (sans barre oblique finale).
VITE_SITE_API_BASE=https://app.leacrm.com/api/sites/public

# Jeton PUBLIC du site (43 caractères), imprimé par `npm run site:provision`
# côté CRM ou visible dans Lea CRM, Réglages du site > Jetons d'accès.
# Lecture seule du contenu publié : ce n'est pas un secret. Ne JAMAIS mettre
# ici le jeton d'APERÇU (il se passe dans l'URL, ?preview=..., et nulle part
# dans le dépôt).
VITE_SITE_PUBLIC_TOKEN=
